# ========================================
# Musix 配置文件示例
# 复制此文件为 .env 并填入真实的凭证
# ========================================

# ========== CORS 配置 ==========
# 允许访问 API 的源（域名），多个源用逗号分隔
# 生产环境建议设置具体的域名，开发环境可以使用 *
# 示例: http://localhost:3000,https://example.com
ALLOWED_ORIGINS=*


# ========== 网易云音乐配置 ==========
# 从浏览器 Cookie 中获取 MUSIC_U 值
# 1. 访问 https://music.163.com 并登录
# 2. 按 F12 打开开发者工具
# 3. 在 Application -> Cookies -> https://music.163.com 中找到 MUSIC_U
# 4. 复制其值并填入下方

NETEASE_MUSIC_U=your_music_u_here


# ========== Bilibili 配置 ==========
# 从浏览器 Cookie 中获取以下值
# 1. 访问 https://www.bilibili.com 并登录
# 2. 按 F12 打开开发者工具
# 3. 在 Application -> Cookies -> https://www.bilibili.com 中找到对应的值
# 4. 复制并填入下方

BILIBILI_SESSDATA=your_sessdata_here
BILIBILI_BILI_JCT=your_bili_jct_here
BILIBILI_BUVID3=your_buvid3_here


# ========== 注意事项 ==========
# 1. 启动时会自动从环境变量读取凭证并登录
# 2. 如果未提供凭证，对应平台将无法使用需要登录的功能
# 3. Cookie 有过期时间，如果登录失败，请重新获取
# 4. 请勿将包含真实凭证的 .env 文件提交到版本控制系统

