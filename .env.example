# Bilibili 凭证配置
# 从浏览器 Cookie 中获取以下值
# 访问 https://www.bilibili.com 登录后，按 F12 打开开发者工具
# 在 Application -> Cookies -> https://www.bilibili.com 中找到对应的值

SESSDATA=your_sessdata_here
BILI_JCT=your_bili_jct_here
BUVID3=your_buvid3_here

# 网易云音乐 Cookie 配置（可选）
# 从浏览器 Cookie 中获取 MUSIC_U 值
# 访问 https://music.163.com 登录后，按 F12 打开开发者工具
# 在 Application -> Cookies -> https://music.163.com 中找到 MUSIC_U

NETEASE_MUSIC_U=your_music_u_here
